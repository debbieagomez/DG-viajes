@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DG_viajes</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DG_viajes.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">DG_viajes</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                          <a class="nav-link text-dark" asp-area="" asp-controller="Clientes" asp-action="Index">Clientes</a>
                    </li>
                        <li class="nav-item">
                         <a class="nav-link text-dark" asp-area="" asp-controller="Destinos" asp-action="Index">Destinos</a>
                     </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Hospedajes" asp-action="Index">Hospedajes</a>
                          </li>
                          <li class="nav-item">
                         <a class="nav-link text-dark" asp-area="" asp-controller="Paquetes" asp-action="Index">Paquetes</a>
                          </li>
                          <li class="nav-item">
                          <a class="nav-link text-dark" asp-area="" asp-controller="Reservas" asp-action="Index">Reservas</a>
                          </li>
                          <li class="nav-item">
                          <a class="nav-link text-dark" asp-area="" asp-controller="Pagos" asp-action="Index">Pagos</a>
                          </li>
                          <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                            @if (User.IsInRole("Administrador"))
                               {
                            <li class="nav-item">
                             <a class="nav-link text-dark" asp-area="" asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                               </li>
                               }
                          </li>
                    </ul>
                    <ul class="navbar-nav">
                      @if (User.Identity?.IsAuthenticated == true)
                      {
                       var avatar = User.FindFirst("Avatar")?.Value;
                        <li class="nav-item">
                       <a class="nav-link text-dark d-flex align-items-center" asp-controller="Cuenta" asp-action="Perfil">
                       @if (!string.IsNullOrEmpty(avatar))
                         {
                           <img src="@avatar" alt="" width="32" height="32" class="rounded-circle me-2" style="object-fit:cover" />
                           }
                          @User.FindFirst(ClaimTypes.GivenName)?.Value
                           </a>
                          </li>
                         <li class="nav-item">
                           <form asp-controller="Cuenta" asp-action="Logout" method="post">
                           <button type="submit" class="btn btn-link nav-link text-dark">Salir</button>
                            </form>
                           </li>
                            }
                              else
                              {
                                <li class="nav-item">
                              <a class="nav-link text-dark" asp-controller="Cuenta" asp-action="Login">Ingresar</a>
                               </li>
                               }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - DG_viajes - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
