
@model IEnumerable<DG_viajes.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
    int paginaActual = ViewBag.PaginaActual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int cantidad = ViewBag.Cantidad ?? 0;
    string? busqueda = ViewBag.Busqueda;
}

<div class="container mt-4">
    @if (TempData["Error_Clientes"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Cliente</h1>
        <a asp-action="Crear" class="btn btn-primary">Nuevo Cliente</a>
    </div>

    <form asp-action="Index" method="get" class="row g-2 mb-4">
        <div class="col-md-8">
            <input type="text" name="busqueda" value="@busqueda" class="form-control" placeholder="Buscar por DNI, nombre, apellido o email" />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-outline-primary">Buscar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>

    <div class="mb-3"><strong>Total de Clientes:</strong> @cantidad</div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No hay Clientes registrados.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>DNI</th>
                        <th>Apellido y Nombre</th>
                        <th>Email</th>
                        <th>Telefono</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cliente in Model)
                    {
                        <tr>
                            <td>@cliente.Dni</td>
                            <td>@cliente.Apellido, @cliente.Nombre</td>
                            <td>@(cliente.Email ?? "-")</td>
                            <td>@(cliente.Telefono ?? "-")</td>
                            <td>@(cliente.Activo ? "Activo" : "Inactivo")</td>
                            <td>
                                <a asp-action="Editar" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                @if (User.IsInRole("Administrador"))
                                {
                                    <a asp-action="Eliminar" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (totalPaginas > 1)
    {
        <nav class="mt-3" aria-label="Paginación de Cliente">
            <ul class="pagination">
                @if (paginaActual > 1)
                {
                    <li class="page-item"><a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)" asp-route-busqueda="@busqueda">Anterior</a></li>
                }
                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == paginaActual ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-busqueda="@busqueda">@i</a></li>
                }
                @if (paginaActual < totalPaginas)
                {
                    <li class="page-item"><a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)" asp-route-busqueda="@busqueda">Siguiente</a></li>
                }
            </ul>
        </nav>
    }
</div>
