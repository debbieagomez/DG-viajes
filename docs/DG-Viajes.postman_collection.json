        },
        {
          "name": "Listar con filtros combinados",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Todos son del destino 1\", function () { pm.response.json().items.forEach(function (p) { pm.expect(p.destinoId).to.eql(1); }); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/paquetes?destinoId=1&precioMin=300000&precioMax=500000&salidaDesde=2027-01-01&estado=Disponible&pagina=1&tamanio=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "paquetes"
              ],
              "query": [
                {
                  "key": "destinoId",
                  "value": "1"
                },
                {
                  "key": "precioMin",
                  "value": "300000"
                },
                {
                  "key": "precioMax",
                  "value": "500000"
                },
                {
                  "key": "salidaDesde",
                  "value": "2027-01-01"
                },
                {
                  "key": "estado",
                  "value": "Disponible"
                },
                {
                  "key": "pagina",
                  "value": "1"
                },
                {
                  "key": "tamanio",
                  "value": "5"
                }
              ]
            }
          }
        },
