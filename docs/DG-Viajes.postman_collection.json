{
  "info": {
    "name": "DG Viajes - Web API (JWT)",
    "description": "Coleccion de pruebas de la Web API. Ejecutar primero 'Login (admin)': guarda el token en la variable {{token}} y el resto de las peticiones lo envian como Bearer. Cambiar baseUrl si la app corre en otro puerto. Importable en Postman, Bruno e Insomnia.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5213"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Autenticacion",
      "item": [
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Devuelve un token\", function () { pm.expect(json.token).to.be.a(\"string\").and.not.empty; });",
                  "pm.collectionVariables.set(\"token\", json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@dgviajes.com\",\n  \"password\": \"123456\"\n}"
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Usuario Administrador. Guarda el token en {{token}}."
          }
        },
        {
          "name": "Login (empleado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"tokenEmpleado\", pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"empleado@dgviajes.com\",\n  \"password\": \"123456\"\n}"
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Usuario Empleado. Guarda el token en {{tokenEmpleado}} (se usa para probar que la auditoria no se muestra)."
          }
        },
