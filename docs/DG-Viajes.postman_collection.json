    {
      "name": "2. Paquetes",
      "item": [
        {
          "name": "Listar paquetes (paginado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test(\"Trae items, total y pagina\", function () { pm.expect(json).to.have.keys(\"items\", \"total\", \"pagina\", \"tamanio\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/paquetes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "paquetes"
